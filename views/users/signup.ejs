<% layout("/layouts/boilerplate")%>
<div class="row mt-3">
<div class="auth-wrap">
  <div class="auth-card">
<div class="auth-logo"><i class="fa-regular fa-compass"></i></div>
<h2 class="tk-page-title text-center">SignUP on Thikana</h2>
<p class="tk-page-sub text-center">Find a place that feels like yours.</p>

<div class="tk-form-card">
<form action="/signup" method="post"  class="needs-validation" novalidate >


<div class="mb-3">
<label for="username" class="form-label">username:</label>
<input required type="text" name="username" id="username"  class="form-control">
<div class="valid-feedback">Looks good!</div>
<div class="invalid-feedback">username should be valid</div>
</div>


<div class="mb-3">
<label for="email" class="form-label">Email:</label>
<input required type="email" id="email" name="email" class="form-control">
<div class="valid-feedback">Looks good!</div>
<div class="invalid-feedback">email should be valid</div>
</div>


<div class="mb-3">
<label for="password" class="form-label">Password:</label>
<input required type="password" name="password" id="password" class="form-control">
<div class="valid-feedback">Looks good!</div>
<div class="invalid-feedback">password should be valid</div>
</div>


<button class="tk-btn tk-btn-primary w-100 mt-2">SignUp</button>


</form>
</div>
<p class="auth-foot">Already have an account? <a href="/login">Login</a></p>

  </div>
</div>
  </div>
