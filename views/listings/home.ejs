<% layout("/layouts/boilerplate") %>

<div class="tk-home">

  <!-- Hero -->
  <section class="tk-hero" aria-labelledby="tk-hero-title">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-6">
          <span class="tk-eyebrow tk-enter" style="--i:0"><i class="tk-eyebrow__dot"></i>STAYS THAT FEEL LIKE HOME</span>
          <h1 id="tk-hero-title" class="tk-display tk-enter" style="--i:1">
            Find <span class="tk-accent">your place</span> in the world.
          </h1>
          <p class="tk-lead tk-enter" style="--i:2">
            From peaceful mountain hideaways to beautiful city apartments, discover spaces that make every journey feel a little more like home.
          </p>
          <div class="d-flex flex-column flex-sm-row gap-3 tk-enter" style="--i:3">
            <a href="/listings" class="tk-btn tk-btn-primary tk-btn-lg">
              Discover Your Next Stay
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href="/listings/new" class="tk-btn tk-btn-outline tk-btn-lg">Become a Host</a>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="tk-stage tk-enter" style="--i:2">
            <figure class="tk-img tk-stage__img">
              <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1000&q=75" alt="A modern villa glowing warmly in the evening light" width="1000" height="1150" fetchpriority="high">
            </figure>
            <span class="tk-float tk-float--1">A little closer to nature.</span>
            <span class="tk-float tk-float--2 tk-float--dark">Your kind of escape.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Stay Types -->
  <section class="tk-section tk-section--soft" aria-labelledby="tk-types-title">
    <div class="container">
      <div class="row align-items-start g-5">
        <div class="col-lg-6 order-lg-2">
          <figure class="tk-img tk-split__img tk-reveal">
            <img src="https://images.unsplash.com/photo-1449158743715-0a90ebb6d2d8?auto=format&fit=crop&w=900&q=75" alt="A wooden cabin beside a quiet mountain lake" width="900" height="1100" loading="lazy">
            <span class="tk-float tk-float--dark">Made for slow mornings.</span>
          </figure>
        </div>

        <div class="col-lg-6 order-lg-1">
          <div class="tk-reveal">
            <span class="tk-kicker">Discover</span>
            <h2 id="tk-types-title" class="tk-h2">A stay for every kind of <span class="tk-accent">story.</span></h2>
            <p class="tk-copy">Wake up to mountain air, spend slow afternoons beside the sea, or find a quiet corner in a city you've always wanted to explore. Every destination begins with the feeling of finding your own place to belong.</p>
          </div>

          <ul class="tk-types tk-reveal">
            <li><a class="tk-type" href="/listings?category=Bedroom"><span class="tk-type__name">Cozy Homestays</span><span class="tk-type__text">Warm rooms, quiet corners, and the comfort of a place that feels lived in.</span><span class="tk-type__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></li>
            <li><a class="tk-type" href="/listings?category=Luxe"><span class="tk-type__name">Luxury Villas</span><span class="tk-type__text">Open spaces, private pools, and design made for unhurried days.</span><span class="tk-type__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></li>
            <li><a class="tk-type" href="/listings?category=Design"><span class="tk-type__name">City Apartments</span><span class="tk-type__text">Light-filled spaces in the middle of everything you came to explore.</span><span class="tk-type__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></li>
            <li><a class="tk-type" href="/listings?category=TreeHouse"><span class="tk-type__name">Nature Retreats</span><span class="tk-type__text">Birdsong, green views, and a slower rhythm.</span><span class="tk-type__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></li>
            <li><a class="tk-type" href="/listings?category=Camping"><span class="tk-type__name">Mountain Escapes</span><span class="tk-type__text">Crisp air, wide skies, and cabins made for long evenings.</span><span class="tk-type__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></li>
            <li><a class="tk-type" href="/listings?category=Beach"><span class="tk-type__name">Beachside Stays</span><span class="tk-type__text">Salt air, soft sunsets, and the sea at your door.</span><span class="tk-type__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- why-section -->
  <section class="tk-section tk-section--warm" aria-labelledby="tk-why-title">
    <div class="container">
      <div class="tk-head tk-head--narrow tk-reveal">
        <span class="tk-kicker">Why Thikana</span>
        <h2 id="tk-why-title" class="tk-h2">Travel that feels <span class="tk-accent">personal.</span></h2>
      </div>
      <div class="row g-4">
        <div class="col-md-6 col-lg-3 tk-reveal">
          <article class="tk-benefit">
            <span class="tk-benefit__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span>
            <h3 class="tk-benefit__title">Comfortable Stays</h3>
            <p class="tk-benefit__text">Thoughtfully selected spaces designed to help you rest, recharge, and feel at ease.</p>
          </article>
        </div>
        <div class="col-md-6 col-lg-3 tk-reveal">
          <article class="tk-benefit">
            <span class="tk-benefit__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></span>
            <h3 class="tk-benefit__title">Warm Hospitality</h3>
            <p class="tk-benefit__text">Hosts who care about the details, so every arrival feels welcoming.</p>
          </article>
        </div>
        <div class="col-md-6 col-lg-3 tk-reveal">
          <article class="tk-benefit">
            <span class="tk-benefit__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg></span>
            <h3 class="tk-benefit__title">Easy Discovery</h3>
            <p class="tk-benefit__text">Browse by place, mood, or style and find the stay that fits your plans.</p>
          </article>
        </div>
        <div class="col-md-6 col-lg-3 tk-reveal">
          <article class="tk-benefit">
            <span class="tk-benefit__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/></svg></span>
            <h3 class="tk-benefit__title">Local Character</h3>
            <p class="tk-benefit__text">Stay close to the culture, the food, and the stories that make a place unique.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!--  FAQ -->
<section class="tk-section tk-section--soft" aria-labelledby="tk-faq-title">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-4">
        <div class="tk-faq__side tk-reveal">
          <span class="tk-kicker">FAQ</span>
          <h2 id="tk-faq-title" class="tk-h2">Questions, <span class="tk-accent">answered.</span></h2>
        </div>
      </div>
      <div class="col-lg-8">
        <div class="tk-faq tk-reveal">
          <div class="tk-faq__item">
            <span class="tk-faq__icon" aria-hidden="true">+</span>
            <h3 class="tk-faq__q">What is Thikana?</h3>
            <p class="tk-faq__a">Thikana is a place to discover stays that feel welcoming, comfortable, and personal — from city apartments to quiet retreats.</p>
          </div>
          <div class="tk-faq__item">
            <span class="tk-faq__icon" aria-hidden="true">+</span>
            <h3 class="tk-faq__q">What kinds of stays can I explore?</h3>
            <p class="tk-faq__a">Cozy homestays, luxury villas, mountain escapes, beachside stays, and modern city apartments.</p>
          </div>
          <div class="tk-faq__item">
            <span class="tk-faq__icon" aria-hidden="true">+</span>
            <h3 class="tk-faq__q">How do I choose the right stay?</h3>
            <p class="tk-faq__a">Browse by destination and style, then pick the space that suits your mood, your budget, and the trip you have in mind.</p>
          </div>
          <div class="tk-faq__item">
            <span class="tk-faq__icon" aria-hidden="true">+</span>
            <h3 class="tk-faq__q">Can I share my own place?</h3>
            <p class="tk-faq__a">Yes. Become a host and welcome guests into a space you've made your own.</p>
          </div>
          <div class="tk-faq__item">
            <span class="tk-faq__icon" aria-hidden="true">+</span>
            <h3 class="tk-faq__q">Can I leave a review?</h3>
            <p class="tk-faq__a">Yes — once you're logged in, you can rate a stay and share what made it special for the next traveller.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

  <!-- CTA -->
  <section class="tk-cta" aria-labelledby="tk-cta-title">
    <img class="tk-cta__bg" src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1600&q=70" alt="" aria-hidden="true" loading="lazy">
    <div class="tk-cta__shade" aria-hidden="true"></div>
    <div class="container">
      <h2 id="tk-cta-title" class="tk-cta__title tk-reveal">Your next story starts with <span class="tk-accent">where you stay.</span></h2>
      <p class="tk-cta__text tk-reveal">Find a space that feels right, and make the journey your own.</p>
      <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 tk-reveal">
        <a href="/listings" class="tk-btn tk-btn-primary tk-btn-lg">Start Exploring</a>
        <a href="/listings/new" class="tk-btn tk-btn-light tk-btn-lg">Become a Host</a>
      </div>
    </div>
  </section>

</div>
