<% layout("/layouts/boilerplate") %>
<%
  const categoryIcons = {
    Beach: "umbrella-beach", Design: "compass-drafting", TreeHouse: "tree", Luxe: "gem",
    Bedroom: "bed", Iconic: "star", Pools: "person-swimming", Camping: "campground",
    Dine: "utensils", Bars: "martini-glass", Cafe: "mug-hot", Spa: "spa", Trending: "fire"
  };
  const reviews = listing.reviews || [];
  const isOwner = currUser && listing.owner._id.equals(currUser._id);
  const average = reviews.length ? reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length : 0;
  const formatDate = (d) => new Date(d).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });
%>

<div class="row mt-2">
  <div class="col-lg-8 mx-auto tk-show">

    <!-- Header + photo -->
    <section>
      <a href="/listings" class="show-back"><i class="fa-solid fa-arrow-left"></i> All stays</a>
      <h1 class="show-title mb-1"><%= listing.title %></h1>
      <p class="show-location mb-3"><i class="fa-solid fa-location-dot"></i><%= listing.location %>, <%= listing.country %></p>

      <div class="show-hero">
        <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="show-img" fetchpriority="high">
      </div>
    </section>

    <!-- Details -->
    <section class="tk-panel">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <span class="meta-pill">
          <% if (categoryIcons[listing.category]) { %><i class="fa-solid fa-<%= categoryIcons[listing.category] %>"></i><% } %>
          <%= listing.category %>
        </span>
        <p class="price-tag mb-0">&#8377;<%= listing.price.toLocaleString("en-IN") %> <small>/ night</small></p>
      </div>

      <p class="mb-4">
        Hosted by
        <span class="owner-chip"><span class="avatar"><i class="fa-solid fa-user"></i></span>@<%= listing.owner.username %></span>
      </p>

      <p class="mb-4"><%= listing.description %></p>

      <div class="meta-row">
        <span class="meta-pill"><i class="fa-solid fa-location-dot"></i><%= listing.location %></span>
        <span class="meta-pill"><i class="fa-solid fa-earth-asia"></i><%= listing.country %></span>
      </div>

      <% if (isOwner) { %>
        <div class="btns mb-0">
          <a href="/listings/<%= listing._id %>/edit" class="tk-btn tk-btn-dark"><i class="fa-solid fa-pen"></i> Edit</a>
          <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
            <button onclick="return confirm('Are you sure you want to delete this listing?')" class="tk-btn tk-btn-danger-soft"><i class="fa-regular fa-trash-can"></i> Delete</button>
          </form>
        </div>
      <% } %>
    </section>

    <!-- Reviews -->
    <section id="reviews">
      <% if (currUser) { %>
        <h2 class="h4 mb-3">Leave a review</h2>
        <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation tk-panel">
          <div class="mb-3">
            <label class="form-label">Rating</label>
            <fieldset class="starability-slot">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <% [["Terrible", 1], ["Not good", 2], ["Average", 3], ["Very good", 4], ["Amazing", 5]].forEach(([label, n]) => { %>
                <input type="radio" id="first-rate<%= n %>" name="review[rating]" value="<%= n %>" />
                <label for="first-rate<%= n %>" title="<%= label %>"><%= n %> star<%= n > 1 ? "s" : "" %></label>
              <% }) %>
            </fieldset>
          </div>
          <div class="mb-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea name="review[comment]" required class="form-control" id="comment" rows="5" placeholder="Share what made your stay special"></textarea>
            <div class="invalid-feedback">Please add some comments for your review.</div>
          </div>
          <button class="tk-btn tk-btn-primary">Submit review</button>
        </form>
      <% } else { %>
        <div class="tk-panel review-lock">
          <span class="error-icon"><i class="fa-solid fa-lock"></i></span>
          <h3 class="fw-bold">Log in to leave a review</h3>
          <p class="text-secondary mb-3">Only signed-in guests can rate and review a stay.</p>
          <div class="d-flex flex-wrap justify-content-center gap-2">
            <a href="/login" class="tk-btn tk-btn-primary">Log in</a>
            <a href="/signup" class="tk-btn tk-btn-ghost">Create account</a>
          </div>
        </div>
      <% } %>

      <div class="mt-5">
        <div class="review-summary">
          <h2>Reviews <span class="text-secondary">(<%= reviews.length %>)</span></h2>
          <% if (reviews.length) { %>
            <p class="starability-result" data-rating="<%= Math.round(average) %>"></p>
            <span class="review-score"><%= average.toFixed(1) %> average</span>
          <% } %>
        </div>

        <% if (reviews.length) { %>
          <div class="row g-3">
            <% [...reviews].reverse().forEach((review) => { %>
              <div class="col-12 col-md-6">
                <article class="review-card">
                  <header class="review-head">
                    <span class="review-avatar" aria-hidden="true"><i class="fa-solid fa-user"></i></span>
                    <div class="review-meta">
                      <span class="review-author">@<%= review.author.username %></span>
                      <% if (review.createdAt) { %>
                        <time class="review-date" datetime="<%= new Date(review.createdAt).toISOString() %>"><%= formatDate(review.createdAt) %></time>
                      <% } %>
                    </div>
                  </header>
                  <p class="starability-result" data-rating="<%= review.rating %>"></p>
                  <p class="review-text"><%= review.comment %></p>
                  <% if (currUser && review.author._id.equals(currUser._id)) { %>
                    <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                      <button onclick="return confirm('Are you sure you want to delete this Review?')"        class="tk-btn tk-btn-ghost tk-btn-sm"><i class="fa-regular fa-trash-can"></i> Delete</button>
                    </form>
                  <% } %>
                </article>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="review-empty">No reviews yet. Be the first to share your stay.</p>
        <% } %>
      </div>
    </section>

    <!-- Map -->
    <section>
      <h2 class="h4 mb-3">Where you will be</h2>
      <div id="map"></div>
    </section>

  </div>
</div>

<!-- Mapbox is only needed on this page -->
<link href="https://api.mapbox.com/mapbox-gl-js/v3.33.0/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.33.0/mapbox-gl.js"></script>
<script>
  const map_token = "<%= process.env.MAP_TOKEN %>";
  // only what map.js reads, not the whole listing with every review
  const listing = <%- JSON.stringify({ title: listing.title, geometry: listing.geometry }).replace(/</g, "\\u003c") %>;
</script>
<script src="/js/map.js"></script>
