<% layout("/layouts/boilerplate")  %>
<div class="row mt-3">

  <div class="col-lg-8 mx-auto">

    <h3 class="tk-page-title">Create a New Listing</h3>
    <p class="tk-page-sub">Tell travelers what makes your place special.</p>

    <div class="tk-form-card">
  <form method="post" action="/listings" enctype="multipart/form-data" novalidate class="needs-validation">

<div class="mb-3">
<label for="title" class="form-label">Title</label>
<input required type="text" id="title" name="listing[title]" placeholder="add a catchy title" class="form-control">
<div class="valid-feedback">Looks good!</div>
<div class="invalid-feedback">Title should be valid</div>

</div>

<div class="mb-3">
<label for="description" class="form-label">Description</label>
<textarea required    type="text" id="description" rows="4" name="listing[description]" class="form-control"></textarea>
<div class="valid-feedback">Looks good!</div>
<div class="invalid-feedback">Description should be valid</div>
</div>


<div class="mb-3">
<label for="image" class="form-label">Image</label>
<input type="file" id="image" name="listing[image]"  class="form-control">
</div>

<div class="row">

<div class="mb-3 col-md-4" >
<label for="price" class="form-label">Price</label>
<div class="input-group">
<span class="input-group-text">&#8377;</span>
<input required     placeholder="1200" id="price" name="listing[price]" class="form-control">
</div>
<div class="valid-feedback">Looks good!</div>
<div class="invalid-feedback">Price should be valid</div>
</div>



<div class=" mb-3 col-md-8">
<label for="country" class="form-label">Country</label>
<input required    type="text" placeholder="India" id="country" name="listing[country]" class="form-control">
<div class="valid-feedback">Looks good!</div>
<div class="invalid-feedback">Country should be valid</div>
</div>
</div>

<div class="mb-3">
<label for="location" class="form-label">Location</label>
<input  required    type="text" placeholder="Jaipur,Rajasthan" id="location" name="listing[location]" class="form-control">
<div class="valid-feedback">Looks good!</div>
<div class="invalid-feedback">Location should be valid</div>
</div>



<div class="mb-3">
  <label for="category" class="form-label">Category</label>

  <select
    required
    id="category"
    name="listing[category]"
    class="form-select"
  >
    <option value="" selected disabled>Choose a category</option>

    <option value="Trending">Trending</option>
    <option value="Design">Design</option>
    <option value="TreeHouse">TreeHouse</option>
    <option value="Luxe">Luxe</option>
    <option value="Bedroom">Bedroom</option>
    <option value="Iconic">Iconic</option>
    <option value="Beach">Beach</option>
    <option value="Pools">Pools</option>
    <option value="Camping">Camping</option>
    <option value="Dine">Dine</option>
    <option value="Bars">Bars</option>
    <option value="Cafe">Cafe</option>
    <option value="Spa">Spa</option>
  </select>

  <div class="invalid-feedback">
    Please select a category.
  </div>
</div>


<button class="tk-btn tk-btn-primary mt-3">Add</button>


</form>
    </div>
</div>
</div>
